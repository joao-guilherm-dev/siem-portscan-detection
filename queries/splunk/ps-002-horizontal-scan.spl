```PS-002 | Port scan horizontal (mesma porta em muitos hosts) | MITRE T1046 / T1595.001
Típico de movimento lateral (445, 3389, 22, 5985) e de varredura de internet em busca de serviço exposto.
Agendamento: a cada 5 min | Janela: -6m@m..-1m@m | Throttle: por src_ip + dest_port por 15 min```
index=network earliest=-6m@m latest=-1m@m
| where isnotnull(src_ip) AND isnotnull(dest_ip) AND isnotnull(dest_port)
| where NOT (cidrmatch("224.0.0.0/4",dest_ip) OR dest_ip="255.255.255.255" OR cidrmatch("169.254.0.0/16",dest_ip))
| lookup portscan_allowlist cidr AS src_ip OUTPUT name AS allow_name
| where isnull(allow_name)
| lookup portscan_service_exceptions cidr AS src_ip, port AS dest_port OUTPUT name AS svc_name
| where isnull(svc_name)
| eval action_norm=case(match(lower(action),"^(block|den|drop|reject|reset)"),"blocked", match(lower(action),"^(allow|accept|permit)"),"allowed", true(),"other")
| stats count AS events, dc(dest_ip) AS distinct_hosts, sum(eval(if(action_norm="blocked",1,0))) AS blocked, values(dest_ip) AS hosts, min(_time) AS first_seen, max(_time) AS last_seen BY src_ip, dest_port
| eval blocked_ratio=round(blocked/events,2)
| where distinct_hosts>=15 AND events>=15 AND blocked_ratio>=0.5
```Porta sensível eleva a severidade```
| eval sensitive=if(match(dest_port,"^(21|22|23|135|139|445|1433|3306|3389|5432|5985|5986)$"),1,0)
| eval severity=case(distinct_hosts>=100 OR (sensitive=1 AND distinct_hosts>=40),"high", distinct_hosts>=40 OR sensitive=1,"medium", true(),"low")
| eval src_scope=if(cidrmatch("10.0.0.0/8",src_ip) OR cidrmatch("172.16.0.0/12",src_ip) OR cidrmatch("192.168.0.0/16",src_ip),"interno","externo")
| eval sample_hosts=mvjoin(mvindex(hosts,0,4),",")
| convert ctime(first_seen) ctime(last_seen)
| fields src_ip src_scope dest_port distinct_hosts events blocked_ratio severity sensitive sample_hosts first_seen last_seen
| sort - distinct_hosts

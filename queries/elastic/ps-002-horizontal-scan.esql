// PS-002 | Port scan horizontal (mesma porta em muitos hosts) | MITRE T1046 / T1595.001
// Elastic 8.15+ (ES|QL). Agende a cada 5 min.
FROM logs-*, filebeat-*, packetbeat-*
| WHERE @timestamp >= NOW() - 6 minutes AND @timestamp < NOW() - 1 minute
| WHERE event.category == "network" AND source.ip IS NOT NULL AND destination.ip IS NOT NULL AND destination.port IS NOT NULL
| WHERE NOT CIDR_MATCH(destination.ip, "224.0.0.0/4", "255.255.255.255/32", "169.254.0.0/16")
| WHERE NOT CIDR_MATCH(source.ip, "10.10.50.5/32", "10.10.60.10/32")
| WHERE NOT (CIDR_MATCH(source.ip, "10.10.70.2/32") AND destination.port IN (443, 8443))
| EVAL blocked_flag = CASE(event.outcome == "failure" OR event.action IN ("denied", "deny", "drop", "dropped", "blocked", "block", "reject", "rejected", "reset"), 1, 0)
| STATS events = COUNT(*), distinct_hosts = COUNT_DISTINCT(destination.ip), blocked = SUM(blocked_flag), first_seen = MIN(@timestamp), last_seen = MAX(@timestamp) BY source.ip, destination.port
| EVAL blocked_ratio = ROUND(TO_DOUBLE(blocked) / events, 2)
| WHERE distinct_hosts >= 15 AND events >= 15 AND blocked_ratio >= 0.5
| EVAL sensitive_port = CASE(destination.port IN (21, 22, 23, 135, 139, 445, 1433, 3306, 3389, 5432, 5985, 5986), true, false)
| EVAL severity = CASE(distinct_hosts >= 100 OR (sensitive_port AND distinct_hosts >= 40), "high", distinct_hosts >= 40 OR sensitive_port, "medium", "low")
| SORT distinct_hosts DESC
| LIMIT 100

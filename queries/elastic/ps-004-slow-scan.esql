// PS-004 | Scan lento (low-and-slow) | MITRE T1595.001 / T1046
// Janela de 24 h, agende a cada 1 h. Exige taxa baixa para não duplicar PS-001..003.
FROM logs-*, filebeat-*, packetbeat-*
| WHERE @timestamp >= NOW() - 24 hours
| WHERE event.category == "network" AND source.ip IS NOT NULL AND destination.ip IS NOT NULL AND destination.port IS NOT NULL
| WHERE NOT CIDR_MATCH(destination.ip, "224.0.0.0/4", "255.255.255.255/32", "169.254.0.0/16")
| WHERE NOT CIDR_MATCH(source.ip, "10.10.50.5/32", "10.10.60.10/32")
| WHERE NOT (CIDR_MATCH(source.ip, "10.10.70.2/32") AND destination.port IN (443, 8443))
| EVAL blocked_flag = CASE(event.outcome == "failure" OR event.action IN ("denied", "deny", "drop", "dropped", "blocked", "block", "reject", "rejected", "reset"), 1, 0)
| EVAL hour_bucket = DATE_TRUNC(1 hour, @timestamp)
| STATS events = COUNT(*), distinct_ports = COUNT_DISTINCT(destination.port), active_hours = COUNT_DISTINCT(hour_bucket), blocked = SUM(blocked_flag), first_seen = MIN(@timestamp), last_seen = MAX(@timestamp) BY source.ip, destination.ip
| EVAL blocked_ratio = ROUND(TO_DOUBLE(blocked) / events, 2), events_per_hour = ROUND(TO_DOUBLE(events) / active_hours, 1)
| WHERE distinct_ports >= 40 AND active_hours >= 4 AND blocked_ratio >= 0.7 AND events_per_hour <= 60
| EVAL severity = CASE(distinct_ports >= 150, "high", distinct_ports >= 80, "medium", "low")
| SORT distinct_ports DESC
| LIMIT 100
